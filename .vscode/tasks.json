{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Ghidra MCP: start headless server",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/ghidra-server.ps1"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "close": true
            },
            "problemMatcher": [],
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "Ghidra MCP: stop headless server",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/ghidra-server.ps1",
                "-Stop"
            ],
            "problemMatcher": []
        }
    ]
}
